# Crypto Monitor — zmienne środowiskowe
#
# Skopiuj ten plik jako .env i uzupełnij wartości:
#   cp .env.example .env        (Linux / Mac)
#   copy .env.example .env      (Windows)
#
# Lub użyj skryptu konfiguracyjnego:
#   python setup_env.py

# Tajny klucz Flask (sesje, CSRF)
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Klucz API CoinGecko (darmowy plan Demo)
# Rejestracja: https://www.coingecko.com/pl/api/pricing
COINGECKO_API_KEY=

# Baza danych (tylko dla produkcji — development używa SQLite automatycznie)
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=postgresql://crypto_user:haslo@localhost:5432/crypto_monitor
